{
  "notice": "SYNTHETIC: original illustrative sentences and invented labels/timestamps. Not Steam reviews or evidence about the game.",
  "records": [
    {
      "review_id": "synthetic-000",
      "version_id": "8872c67b39811d26514f80660dccd7da340dbcfe1b3e97046dcead6530387262",
      "app_id": 548430,
      "text": "The caves look wonderful and the new missions are fun. I recommend this game.",
      "text_hash": "b23013c328542b4abbeb44a5184a6d59c301432be501777e4e9edbda23d57859",
      "language": "english",
      "voted_up": true,
      "created_at": 1717052400,
      "updated_at": 1717052400,
      "observed_at": 1792252800,
      "author_group": null,
      "source_url": null
    },
    {
      "review_id": "synthetic-001",
      "version_id": "cde7bfe005972ad03aab22cab16582871f12285762f5704c7c21b99290e9cbcc",
      "app_id": 548430,
      "text": "The game keeps crashing at extraction. I cannot recommend it right now.",
      "text_hash": "1ea73fe0a3b8647c3391a0c9bc41dc40acfc358d2d2255336d1d58607dcbb053",
      "language": "english",
      "voted_up": false,
      "created_at": 1717102800,
      "updated_at": 1717102800,
      "observed_at": 1792252800,
      "author_group": null,
      "source_url": null
    },
    {
      "review_id": "synthetic-002",
      "version_id": "a294300f46d44c01dbe92c4b871f2b27c2d71b1def2f98b59223514c95479d7f",
      "app_id": 548430,
      "text": "Combat feels responsive. The weapons are satisfying and I enjoyed the run.",
      "text_hash": "cc528bc66c3ce63789eb633efee1315d5221ad2c427934db7d26768ce0d792ac",
      "language": "english",
      "voted_up": true,
      "created_at": 1717153200,
      "updated_at": 1717153200,
      "observed_at": 1792252800,
      "author_group": null,
      "source_url": null
    },
    {
      "review_id": "synthetic-003",
      "version_id": "d53ce87da657d7516040b0a7dda94f975a427ff2239d1d5096994d201eefc4e3",
      "app_id": 548430,
      "text": "Frequent stutters make combat unpleasant. Performance needs attention.",
      "text_hash": "7c9a290646c3ee20a3d7891329b95bce011dcd221273264a13735fcf52a304cc",
      "language": "english",
      "voted_up": false,
      "created_at": 1717203600,
      "updated_at": 1717203600,
      "observed_at": 1792252800,
      "author_group": null,
      "source_url": null
    },
    {
      "review_id": "synthetic-004",
      "version_id": "e46697c8f9b6e0aa1f73fe6d48eaae7df209a81de525a3f52aa008b7ac3498e2",
      "app_id": 548430,
      "text": "A lovely co-op evening with friends. The lobby was easy to join.",
      "text_hash": "4bdcde56063a45f55e30ae1e86a23c164e01528c44a01a67ada0d8e67f52e6fd",
      "language": "english",
      "voted_up": true,
      "created_at": 1717254000,
      "updated_at": 1717254000,
      "observed_at": 1792252800,
      "author_group": null,
      "source_url": null
    },
    {
      "review_id": "synthetic-005",
      "version_id": "f87510bda4a6a074513b2b6ab7288b39f2ef5870214be66ad674fd112cb656ba",
      "app_id": 548430,
      "text": "Multiplayer disconnects waste our progress. The server connection is unreliable.",
      "text_hash": "fc3e33acae10f2e82c38e3bb046b1ddd185c40d5605093eb70e01318dbe8afd5",
      "language": "english",
      "voted_up": false,
      "created_at": 1717304400,
      "updated_at": 1717304400,
      "observed_at": 1792252800,
      "author_group": null,
      "source_url": null
    },
    {
      "review_id": "synthetic-006",
      "version_id": "4787feb89a98801a66d061e7ae2d381623f5c65ef54f5b5ef15a767860cf12c0",
      "app_id": 548430,
      "text": "Progression rewards my time. Unlocking equipment feels worthwhile.",
      "text_hash": "50ce7702a8c7e99f8d56e06fa7a553ab7ea749eba89619dc921dced89b0933a1",
      "language": "english",
      "voted_up": true,
      "created_at": 1717354800,
      "updated_at": 1717354800,
      "observed_at": 1792252800,
      "author_group": null,
      "source_url": null
    },
    {
      "review_id": "synthetic-007",
      "version_id": "63e6e7dc44478a1ed3bcff36653dadbc8e2b9490167fde2a3ea2e265922136c3",
      "app_id": 548430,
      "text": "The grind is exhausting and progression feels painfully slow.",
      "text_hash": "752abaf50abc87f2a422308eed778cafdf1439b792f661deadccbd30644f3bdd",
      "language": "english",
      "voted_up": false,
      "created_at": 1717405200,
      "updated_at": 1717405200,
      "observed_at": 1792252800,
      "author_group": null,
      "source_url": null
    },
    {
      "review_id": "synthetic-008",
      "version_id": "b2526355951f565ce3e640671d6e7e39a509c60faa4d1d93d495b0138f4fc7cf",
      "app_id": 548430,
      "text": "The interface is clear and keybinds are easy to change.",
      "text_hash": "50418d71db7d3919d36ae1b3dea36826c37e6a71c970c9a889644fba1e2824a2",
      "language": "english",
      "voted_up": true,
      "created_at": 1717455600,
      "updated_at": 1717455600,
      "observed_at": 1792252800,
      "author_group": null,
      "source_url": null
    },
    {
      "review_id": "synthetic-009",
      "version_id": "ad191e35dc690adbe39b342f9b7e1f44d1bbd5afb14d493d35f0adfb5fcd91d4",
      "app_id": 548430,
      "text": "The menu is confusing. I cannot find the controls I need.",
      "text_hash": "5b8556d4283fa1c95a0f77416ca3d206cb8b339c821128aefb17202587a390aa",
      "language": "english",
      "voted_up": false,
      "created_at": 1717506000,
      "updated_at": 1717506000,
      "observed_at": 1792252800,
      "author_group": null,
      "source_url": null
    },
    {
      "review_id": "synthetic-010",
      "version_id": "8c80fe160a777254cbbaabfc4ad3cd9677893d08e496f8a2ceb7da1cffc05b4f",
      "app_id": 548430,
      "text": "The price is fair for so much content. This is excellent value.",
      "text_hash": "8dd81c1321ac5d44b7a3c8f537680b78bdee78e260cf2c58c987e50def6a9347",
      "language": "english",
      "voted_up": true,
      "created_at": 1717556400,
      "updated_at": 1717556400,
      "observed_at": 1792252800,
      "author_group": null,
      "source_url": null
    },
    {
      "review_id": "synthetic-011",
      "version_id": "1a2f54232925389fa75eadcd7ce8c43eeeae0e344acd589f0b4e8c301df6c134",
      "app_id": 548430,
      "text": "The price feels too expensive for the available content.",
      "text_hash": "fbb21995dc89cdd45affb6896a2cb163edc71c78be216063bb9e3c251e9ef053",
      "language": "english",
      "voted_up": false,
      "created_at": 1717606800,
      "updated_at": 1717606800,
      "observed_at": 1792252800,
      "author_group": null,
      "source_url": null
    },
    {
      "review_id": "synthetic-012",
      "version_id": "c518205e75b5281b2f32b20026210e8d0fe62fbc18aea40e5ba33502b921913d",
      "app_id": 548430,
      "text": "Performance is smooth on my computer. Stable fps throughout the mission.",
      "text_hash": "86440caeb5ed9d18c9ee072b1479b89eaf719a4b1fcee4941730a1ec0c2e4a80",
      "language": "english",
      "voted_up": true,
      "created_at": 1717657200,
      "updated_at": 1717657200,
      "observed_at": 1792252800,
      "author_group": null,
      "source_url": null
    },
    {
      "review_id": "synthetic-013",
      "version_id": "ab73b39c0f91f5cf986b62f12921fd6953fc0639d55740eb4bebf4e7bedff59a",
      "app_id": 548430,
      "text": "Low fps makes the new biome hard to enjoy. Disappointing.",
      "text_hash": "f00d85d59f2e38e43a4ab09d44dee4cd7c4b6a7944946c5ee78bdaa97bf12e3a",
      "language": "english",
      "voted_up": false,
      "created_at": 1717707600,
      "updated_at": 1717707600,
      "observed_at": 1792252800,
      "author_group": null,
      "source_url": null
    },
    {
      "review_id": "synthetic-014",
      "version_id": "e6744dc09760153402b1d13de7d05527a4f5133cd60850661f0009bcbfbedcbe",
      "app_id": 548430,
      "text": "The new biome is gorgeous. Exploring these caverns was a delight.",
      "text_hash": "141ebc2c8c7a9db1af88422ccb1950882b944befc5fb3657773a1eedb53f84bd",
      "language": "english",
      "voted_up": true,
      "created_at": 1717758000,
      "updated_at": 1717758000,
      "observed_at": 1792252800,
      "author_group": null,
      "source_url": null
    },
    {
      "review_id": "synthetic-015",
      "version_id": "48d02627493d539c8ac8c2ad31560ed30b809593420eb5e5174f94f1f6d8d3bd",
      "app_id": 548430,
      "text": "I do not enjoy the weapon balance. Combat feels repetitive.",
      "text_hash": "8f443fea48ed426330242b11a8b764a6d8c906a01594918cdae00956194f6a37",
      "language": "english",
      "voted_up": false,
      "created_at": 1717808400,
      "updated_at": 1717808400,
      "observed_at": 1792252800,
      "author_group": null,
      "source_url": null
    },
    {
      "review_id": "synthetic-016",
      "version_id": "affe32be8ee9d1f78eef20a019d0d27b3288ff5f6a396678706c445c9dcfe379",
      "app_id": 548430,
      "text": "Difficulty options let our group find a comfortable challenge.",
      "text_hash": "e5a44c55a23a201c43d959bfa5cb20b9bd5894232ffaa36affc30eb3b9298192",
      "language": "english",
      "voted_up": true,
      "created_at": 1717858800,
      "updated_at": 1717858800,
      "observed_at": 1792252800,
      "author_group": null,
      "source_url": null
    },
    {
      "review_id": "synthetic-017",
      "version_id": "560dcb0fd8d5babc0590d388e1f94d63acea5f81abb5c80b31b34ccff639bd44",
      "app_id": 548430,
      "text": "A frozen screen ended our mission. Stability is poor on my machine.",
      "text_hash": "1add96fd9a4c9be95287ad58586718362aaacc900fc3e365c78a41e7641525d3",
      "language": "english",
      "voted_up": false,
      "created_at": 1717909200,
      "updated_at": 1717909200,
      "observed_at": 1792252800,
      "author_group": null,
      "source_url": null
    },
    {
      "review_id": "synthetic-018",
      "version_id": "69597393123eb20a7965fa653bb2dfcb10a6e820bb9231a5b1bbf7ddb7c14688",
      "app_id": 548430,
      "text": "The subtitles are readable and the accessibility options help me.",
      "text_hash": "2176548549a465d00a26c6dcf33e2228d82f4b55f49f3184b475ddadeb78c05a",
      "language": "english",
      "voted_up": true,
      "created_at": 1717959600,
      "updated_at": 1717959600,
      "observed_at": 1792252800,
      "author_group": null,
      "source_url": null
    },
    {
      "review_id": "synthetic-019",
      "version_id": "c21b71d95856f54a78087040eb5cb5882067f8d96f2a4e9949e473c8e07f0f90",
      "app_id": 548430,
      "text": "The difficulty spikes are frustrating. I would not suggest this to friends.",
      "text_hash": "61cd015a2b91ae690b757001dbae48c19605ad2a518b9f845ec29d768bddbe91",
      "language": "english",
      "voted_up": false,
      "created_at": 1718010000,
      "updated_at": 1718010000,
      "observed_at": 1792252800,
      "author_group": null,
      "source_url": null
    },
    {
      "review_id": "synthetic-020",
      "version_id": "a4d82600113bb674fce210943bca15b3e4ad2a07369e9023084238a5eae3c6c2",
      "app_id": 548430,
      "text": "Not a single crash tonight. A great session overall.",
      "text_hash": "90e8b2a5994029b753255e21b4899891ad556381a457c8c4fe0d781bc34d82a8",
      "language": "english",
      "voted_up": true,
      "created_at": 1718060400,
      "updated_at": 1718060400,
      "observed_at": 1792252800,
      "author_group": null,
      "source_url": null
    },
    {
      "review_id": "synthetic-021",
      "version_id": "b6afb455d28f8f0c82fe62e10b7576f95eae54af459c09949be00265f39fad07",
      "app_id": 548430,
      "text": "Subtitles are too small for me. Accessibility options need work.",
      "text_hash": "45861dbf3ad57ced69a4beb27777209b035ce24eed32ce78747bbb843fea33e8",
      "language": "english",
      "voted_up": false,
      "created_at": 1718110800,
      "updated_at": 1718110800,
      "observed_at": 1792252800,
      "author_group": null,
      "source_url": null
    },
    {
      "review_id": "synthetic-022",
      "version_id": "1199544a288725046390eed6fb05866c322f808e52d0b019ead7db080c79c511",
      "app_id": 548430,
      "text": "The controls feel precise. Mining is relaxing after work.",
      "text_hash": "22c990164769aeaa7b9f76739294ca8302bb9f803ec13bb9e6d5f43859e127b9",
      "language": "english",
      "voted_up": true,
      "created_at": 1718161200,
      "updated_at": 1718161200,
      "observed_at": 1792252800,
      "author_group": null,
      "source_url": null
    },
    {
      "review_id": "synthetic-023",
      "version_id": "0c40fa3673ad8cea9cfe3ef77a8112b59633ef165b8513ac67971761e39052be",
      "app_id": 548430,
      "text": "The lobby failed to connect repeatedly. We gave up playing.",
      "text_hash": "614e0f1c7144da897125d80c5e4f70b274066f79be5b7bbbd79339369299f7d0",
      "language": "english",
      "voted_up": false,
      "created_at": 1718211600,
      "updated_at": 1718211600,
      "observed_at": 1792252800,
      "author_group": null,
      "source_url": null
    },
    {
      "review_id": "synthetic-024",
      "version_id": "09442eb7f3488290a5d0582c765348e9c7f4b0a9f3c85584e23cc06036c63d61",
      "app_id": 548430,
      "text": "The sound design makes every discovery exciting. Recommended.",
      "text_hash": "6629abe24896766ba8baf1da13bc850cca8c3a033ccd45b8d130955fae274103",
      "language": "english",
      "voted_up": true,
      "created_at": 1718348400,
      "updated_at": 1718348400,
      "observed_at": 1792252800,
      "author_group": null,
      "source_url": null
    },
    {
      "review_id": "synthetic-025",
      "version_id": "205ea332da2a1f48bcb4590f4b1847f0cf721e08a6f90faf27cc53b97a3ba06b",
      "app_id": 548430,
      "text": "Unlocking equipment takes too long. Progression is not enjoyable.",
      "text_hash": "273d7a830addedd9c5e3854fa7c0a0f546825c3280c88fea6c9b3058ea6df63e",
      "language": "english",
      "voted_up": false,
      "created_at": 1718398800,
      "updated_at": 1718398800,
      "observed_at": 1792252800,
      "author_group": null,
      "source_url": null
    },
    {
      "review_id": "synthetic-026",
      "version_id": "04f481174e8ce655ed86bc1cf3d1676cd7e73bbb92a60ab955d1275d3526bb63",
      "app_id": 548430,
      "text": "New enemies make combat interesting. I want to play again.",
      "text_hash": "56551de68dd6d8c2c2e212e928ed0c6d91c6a4a8569a96bae2602a57f863cabb",
      "language": "english",
      "voted_up": true,
      "created_at": 1718449200,
      "updated_at": 1718449200,
      "observed_at": 1792252800,
      "author_group": null,
      "source_url": null
    },
    {
      "review_id": "synthetic-027",
      "version_id": "5c917b3f13d46b78809f7e684b99bec55f5f2fe5d445f1f033f715d1d95e8a17",
      "app_id": 548430,
      "text": "The interface hides useful information behind too many menus.",
      "text_hash": "b22059de78b18d3555296709a02182187020bb3d6ad5a801e69a55212f78703e",
      "language": "english",
      "voted_up": false,
      "created_at": 1718499600,
      "updated_at": 1718499600,
      "observed_at": 1792252800,
      "author_group": null,
      "source_url": null
    },
    {
      "review_id": "synthetic-028",
      "version_id": "d15be58695f48c0f5a6a7c6c1f4854178023d0f5850c601fa7c143cd91494b59",
      "app_id": 548430,
      "text": "The mission variety keeps our team coming back. Worth playing.",
      "text_hash": "c641a2044a02f8a8dc0660bc9be7526b1380618b2ce41a678d30c1f26b0ea79b",
      "language": "english",
      "voted_up": true,
      "created_at": 1718550000,
      "updated_at": 1718550000,
      "observed_at": 1792252800,
      "author_group": null,
      "source_url": null
    },
    {
      "review_id": "synthetic-029",
      "version_id": "565f6087d2c93ea6df9d431bb3ddc283906699b02fc3a0655868c9ca7b566af3",
      "app_id": 548430,
      "text": "Not worth the price for me. I stopped after two evenings.",
      "text_hash": "52f11b459400d5340925a536756e0fffd96e7e47a604c00f294876034498e094",
      "language": "english",
      "voted_up": false,
      "created_at": 1718600400,
      "updated_at": 1718600400,
      "observed_at": 1792252800,
      "author_group": null,
      "source_url": null
    },
    {
      "review_id": "synthetic-030",
      "version_id": "2a0878d511e8f5be22fa66b452039e73698701e8e0dfec1f5544a40e2c4497d4",
      "app_id": 548430,
      "text": "I love the exploration, but multiplayer disconnects still interrupt our runs.",
      "text_hash": "da70bfa27595f5e49878e5dec15dea47cd979afa183f4eb7a931aa618656dcd3",
      "language": "english",
      "voted_up": true,
      "created_at": 1718650800,
      "updated_at": 1718650800,
      "observed_at": 1792252800,
      "author_group": null,
      "source_url": null
    },
    {
      "review_id": "synthetic-031",
      "version_id": "cd3d1a6bd7400bdecee29a5c369d1ab1c54df8a28f026ef4d720fc53310b58ac",
      "app_id": 548430,
      "text": "The caves look great, but crashes prevent me from finishing a session.",
      "text_hash": "6452c62ec546ca0eba83f6493ea3918e2e52e3b24dc7d397dc90ee4b3a317fff",
      "language": "english",
      "voted_up": false,
      "created_at": 1718701200,
      "updated_at": 1718701200,
      "observed_at": 1792252800,
      "author_group": null,
      "source_url": null
    },
    {
      "review_id": "synthetic-032",
      "version_id": "bf8a23f19a2ac8f67f1eb3671476246a9aaca1dba5688efbfd3c0ade3a113bb5",
      "app_id": 548430,
      "text": "Great weapon upgrades make each expedition feel different.",
      "text_hash": "28386f882cc8cf893e6cf8a82b29f21ba231559c5709b1ebc40cdea91249f710",
      "language": "english",
      "voted_up": true,
      "created_at": 1718751600,
      "updated_at": 1718751600,
      "observed_at": 1792252800,
      "author_group": null,
      "source_url": null
    },
    {
      "review_id": "synthetic-033",
      "version_id": "ea5c0eb1e8268b856517d4963ed0a2bb799560832d395b9e62f2b678981ee938",
      "app_id": 548430,
      "text": "My keybinds reset every launch. Controls are a constant frustration.",
      "text_hash": "eeead171a0bdf1114f0eadcd1529d4154c1b3450376ed5c44c0908749b8b63c3",
      "language": "english",
      "voted_up": false,
      "created_at": 1718802000,
      "updated_at": 1718802000,
      "observed_at": 1792252800,
      "author_group": null,
      "source_url": null
    },
    {
      "review_id": "synthetic-034",
      "version_id": "e4e2e79ad75a38678c4845cf20595642d898cb5571c17ffe1e08c66cc0dd3f60",
      "app_id": 548430,
      "text": "Quick matchmaking found a friendly server. An enjoyable evening.",
      "text_hash": "9fa9a03f95ac75b4928185ab06ac192e729ab8c9db75b3e9885128fad3c96510",
      "language": "english",
      "voted_up": true,
      "created_at": 1718852400,
      "updated_at": 1718852400,
      "observed_at": 1792252800,
      "author_group": null,
      "source_url": null
    },
    {
      "review_id": "synthetic-035",
      "version_id": "3a7a5c837c2a2ee66c902d8f827d6b6ff3faa38717b4db2927a949e0bf479a44",
      "app_id": 548430,
      "text": "Frame drops during swarms spoil the best moments.",
      "text_hash": "3326fc5e4cff8331df094856bc436fb49fdff370a43c895d2a70c8349b389ad3",
      "language": "english",
      "voted_up": false,
      "created_at": 1718902800,
      "updated_at": 1718902800,
      "observed_at": 1792252800,
      "author_group": null,
      "source_url": null
    },
    {
      "review_id": "synthetic-036",
      "version_id": "134e4c8915dfd3d7e2977f5dcfb40bb8171701ebb74520b3bb579fa4939ad976",
      "app_id": 548430,
      "text": "The tutorial explains the interface well. Easy to get started.",
      "text_hash": "e745fd5af5ada5b27f2caaf386d988a159c486f9afe249dbb7c0a1bb2b1efc82",
      "language": "english",
      "voted_up": true,
      "created_at": 1718953200,
      "updated_at": 1718953200,
      "observed_at": 1792252800,
      "author_group": null,
      "source_url": null
    },
    {
      "review_id": "synthetic-037",
      "version_id": "3218b2360ae9a740c14ddf306e97114f7f865d414a897d2338a2931878e540c8",
      "app_id": 548430,
      "text": "The connection failed at the final objective. A terrible evening.",
      "text_hash": "35aaa202f9fee64a2e73f71796b80b0ae525004e002b84415fe23cc32f1ae875",
      "language": "english",
      "voted_up": false,
      "created_at": 1719003600,
      "updated_at": 1719003600,
      "observed_at": 1792252800,
      "author_group": null,
      "source_url": null
    },
    {
      "review_id": "synthetic-038",
      "version_id": "50a9f9ccf8c08979fc8bdb6f4404fd313415e6fcca51a1ef9d09f0b7f6d34953",
      "app_id": 548430,
      "text": "This is a rewarding adventure. My favorite purchase this month.",
      "text_hash": "1e06c945092c9fc854398bbcdb74f5c3d6ab2c3e0de7fa090479a4eb9bf556fb",
      "language": "english",
      "voted_up": true,
      "created_at": 1719054000,
      "updated_at": 1719054000,
      "observed_at": 1792252800,
      "author_group": null,
      "source_url": null
    },
    {
      "review_id": "synthetic-039",
      "version_id": "05e5811d7cc863cd1a92f18b82781091c951e53b13d39bffda74572e1e8a8576",
      "app_id": 548430,
      "text": "The missions are repetitive and the combat no longer feels fun.",
      "text_hash": "eacdc07c96e5bb25ee0bea80aa3cf69a6e2ca9dfb65d019b0f22791190441bb8",
      "language": "english",
      "voted_up": false,
      "created_at": 1719104400,
      "updated_at": 1719104400,
      "observed_at": 1792252800,
      "author_group": null,
      "source_url": null
    },
    {
      "review_id": "synthetic-040",
      "version_id": "9bd39aaaca23479cd5a96edf58320e5171a26624a53b704e365fa402a2be6801",
      "app_id": 548430,
      "text": "My laptop handles the performance well. The caves feel alive.",
      "text_hash": "ab7c36f071f8205625cf476a956394a3c59ac6da8a33aba468e899bb2ec9e011",
      "language": "english",
      "voted_up": true,
      "created_at": 1719154800,
      "updated_at": 1719154800,
      "observed_at": 1792252800,
      "author_group": null,
      "source_url": null
    },
    {
      "review_id": "synthetic-041",
      "version_id": "4d2b93ae7a2b54423bcfb64aaac476f611dffafc51578428e5fc29e238b8cb56",
      "app_id": 548430,
      "text": "I dislike the extra dlc pricing. The value is poor for my budget.",
      "text_hash": "2b5b218afde309df9d51dcea9bfc84d18da700dc7ce4e73712ba26fa045c50fb",
      "language": "english",
      "voted_up": false,
      "created_at": 1719205200,
      "updated_at": 1719205200,
      "observed_at": 1792252800,
      "author_group": null,
      "source_url": null
    },
    {
      "review_id": "synthetic-042",
      "version_id": "11a07822267dd28b63a6f9cb6a435caf2c1a3bb4e80eb454ccc19b30e8611246",
      "app_id": 548430,
      "text": "The soundtrack and atmosphere are fantastic. Strong recommendation.",
      "text_hash": "21a44e3ba4b66c4f8ce8989b88c208c7e908d9f807070d7bec7ae7c19be5a5fe",
      "language": "english",
      "voted_up": true,
      "created_at": 1719255600,
      "updated_at": 1719255600,
      "observed_at": 1792252800,
      "author_group": null,
      "source_url": null
    },
    {
      "review_id": "synthetic-043",
      "version_id": "b86bea4171b4626bcd3f6c4ba7767a040af6ee49d406a2de702ffafe9c733e6b",
      "app_id": 548430,
      "text": "A crash deleted my progress. I will wait for a fix.",
      "text_hash": "5f5c81311bc444b998681d4cedb70f8e3afa9b9192d21b7a3aeb385d28b9eb6c",
      "language": "english",
      "voted_up": false,
      "created_at": 1719306000,
      "updated_at": 1719306000,
      "observed_at": 1792252800,
      "author_group": null,
      "source_url": null
    },
    {
      "review_id": "synthetic-044",
      "version_id": "628c3b4b36811ba27cbb39280d9ee07ee502dffc9414e81c4c68d71c7e560a2d",
      "app_id": 548430,
      "text": "Content is plentiful without extra purchases. A great experience.",
      "text_hash": "ccfeca4d6d70840e78cad8d8de66e186b1488504920457a93347efb7846396e8",
      "language": "english",
      "voted_up": true,
      "created_at": 1719356400,
      "updated_at": 1719356400,
      "observed_at": 1792252800,
      "author_group": null,
      "source_url": null
    },
    {
      "review_id": "synthetic-045",
      "version_id": "43a238c168c99ee329a56a95bbbfa3ea5174d34b20a90a9e2e630377b233b506",
      "app_id": 548430,
      "text": "The new content feels thin and the grind remains tedious.",
      "text_hash": "2552dcf6526a9c10b4e02173763f7f27649af8718fbd4d45c182706b429120d5",
      "language": "english",
      "voted_up": false,
      "created_at": 1719406800,
      "updated_at": 1719406800,
      "observed_at": 1792252800,
      "author_group": null,
      "source_url": null
    },
    {
      "review_id": "synthetic-046",
      "version_id": "ab0732dbe6112a8c11aa2eeef463298a08fd93f189acff20f926522b04ca0a1a",
      "app_id": 548430,
      "text": "I am impressed by the mission design and cooperative pacing.",
      "text_hash": "d1bb74472743e2e7f798a8c1a0f33cf0be0241227c709b302415f31b50dcdb68",
      "language": "english",
      "voted_up": true,
      "created_at": 1719457200,
      "updated_at": 1719457200,
      "observed_at": 1792252800,
      "author_group": null,
      "source_url": null
    },
    {
      "review_id": "synthetic-047",
      "version_id": "b17069a38bad96828332ef7b9abc014b07e2f5ce9958c1f443adfb4a2a0e6212",
      "app_id": 548430,
      "text": "Remapping does not cover every control I use. I cannot play comfortably.",
      "text_hash": "9df8a14486ae939395a2746fd0ffadb7db8cd3101bf3257c1718e4aa0b05e7cc",
      "language": "english",
      "voted_up": false,
      "created_at": 1719507600,
